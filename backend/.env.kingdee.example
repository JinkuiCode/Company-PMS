# 复制所需项到 backend/.env.local，或通过部署环境变量注入。
# .env.local 不提交 Git；macOS/Linux 使用 chmod 600 backend/.env.local。
# 下列值必须在目标账套授权后填写；不能把数据中心名称当成账套 ID。
K3_AUTH_MODE=app
K3_READ_ONLY=true
K3_URL=http://10.10.1.248/k3cloud
K3_ACCT_ID=填写目标账套ID
K3_USERNAME=I0001
K3_APP_ID=填写完整应用ID
K3_APP_SECRET=填写应用密钥
K3_LCID=2052
K3_ORG_NUM=0
# 原密码仅在明确回退时需要，应用模式不使用它。
# K3_PASSWORD=通过受保护配置提供
